// ================================================================
// 🔄 Renovate Configuration
// ================================================================
// Universal dependency automation config for any project type.
// Designed for security-first auto-updates with minimal manual intervention.
//
// 📖 Documentation: https://docs.renovatebot.com
// 🎯 Philosophy:
//    - Security updates:
//        • GitHub vulnerabilityAlerts + OSV → dedicated security PRs
//        • Security fix PRs: immediate auto-merge (may bypass CI)
//    - Stable releases:
//        • minimumReleaseAge = 3 days before updating
//        • Patch/minor: auto-merge after 3-day stabilization
//        • Major: manual review (no automerge)
//    - GitHub Actions (CI/CD):
//        • Patch/minor/major: auto-merge, grouped into a single PR
//        • Grouping keeps CI config updates low-noise
//    - Dev/test dependencies:
//        • grouped into a single PR (less noise)
//
// ⏰ Execution / runtime
// ----------------------
// Renovate is expected to run at least once per day (e.g. via cron on a VPS
// or a scheduled CI job), regardless of the global "schedule" setting below.
//
// Reason:
//   • "schedule" only controls when *regular* dependency updates are allowed
//     to create/update PRs.
//   • Security-related PRs (vulnerabilityAlerts, OSV, etc.) ignore "schedule",
//     but they can only be created when Renovate actually runs.
//   • Daily executions ensure security fixes are raised as soon as possible,
//     while normal updates can still be limited to specific days.
//
// 🔧 To adapt for other projects:
//    1. Update enabledManagers (npm, composer, pip, etc.)
//    2. Adjust matchManagers in packageRules
//    3. Customize project-specific ignore rules
// ================================================================

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // ================================================================
  // 🎯 CORE CONFIGURATION
  // ================================================================
  // Base presets define sensible defaults for most projects
  // ================================================================

  "extends": [
    "config:recommended"      // Recommended baseline config
  ],

  // ================================================================
  // 🔒 GITHUB ACTIONS LOCKFILE (actions.lock)
  // ================================================================
  // Renovate maintains .github/workflows/actions.lock automatically via
  // the gh-actions-lock GitHub CLI extension. By default Renovate pins a
  // specific version of that extension for deterministic updates; we
  // override this to always use the latest extension release instead.
  // ================================================================
  "constraints": {
    "ghActionsLock": ""   // empty string = always use latest gh-actions-lock release
  },

  // ================================================================
  // ⏰ GLOBAL SCHEDULE
  // ================================================================
  // Controls when Renovate creates PRs for dependency updates.

  "schedule": [
    "on monday"
  ],

  // ================================================================
  // 🔒 LOCK FILE MAINTENANCE
  // ================================================================
  // Periodically refresh lock files without changing manifests.
  //
  // Scheduling model:
  //   • The top-level "schedule" (e.g. ["on monday"]) restricts when
  //     Renovate is allowed to create/update PRs in general.
  //   • Local "schedule": ["at any time"] here is intentionally
  //     non-restrictive, so we don't add extra time-of-day windows.
  //
  // Global + local schedules are combined with logical AND:
  //   → Top-level: restricts which days/periods are allowed overall.
  //   → Local:     "at any time" (no extra restriction).
  //   → Result:    lockFileMaintenance follows the same days as the
  //                global schedule, at any time of those days.
  // ================================================================
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time" // Local schedule is non-restrictive; only the global schedule really limits when it runs (AND conditions, not OR).
    ],
    "automerge": true,
    "commitMessagePrefix": "[Lockfile] "
  },

  // ================================================================
  // 🎛️ RATE LIMITING
  // ================================================================
  // Prevents PR/MR spam and controls update flow
  //
  // Recommended values:
  // - Small projects: 5-10 concurrent
  // - Medium projects: 10-20 concurrent
  // - Large monorepos: 20-50 concurrent
  // ================================================================

  "prConcurrentLimit": 10,    // Max 10 PRs open at once
  "prHourlyLimit": 0,         // No hourly limit (controlled by concurrent only)

  // ================================================================
  // 🔧 PACKAGE MANAGERS
  // ================================================================
  // Explicitly enable only the managers you need for better performance.
  // Renovate auto-detects but explicit config is more predictable.
  //
  // Common managers:
  // - gradle, maven (Java/Kotlin)
  // - npm, yarn, pnpm (JavaScript/TypeScript)
  // - composer (PHP)
  // - pip, pipenv, poetry (Python)
  // - bundler (Ruby)
  // - cargo (Rust)
  // - gomod (Go)
  // - docker, dockerfile
  // - github-actions, circleci, gitlab-ci
  //
  // 📝 Customize this list for your project stack!
  // ================================================================

  "enabledManagers": [
    "github-actions"          // GitHub Actions: .github/workflows/*.yml
  ],

  // ================================================================
  // 🔐 SECURITY SETTINGS
  // ================================================================
  // Stability and security policies for dependency updates
  // ================================================================

  // Wait N days before updating to a new version (except security fixes)
  // This allows time for community to discover critical bugs in new releases
  // Security updates bypass this delay (minimumReleaseAge ignores vulnerabilityAlerts)
  "minimumReleaseAge": "3 days",

  // OSV (Open Source Vulnerabilities) integration
  // Provides additional vulnerability data beyond GitHub Security Advisories
  "osvVulnerabilityAlerts": true,

  // ================================================================
  // 🤖 AUTO-MERGE CONFIGURATION
  // ================================================================
  //
  // Choose ONE of the two options below based on your setup.
  // Uncomment the chosen option's settings and comment out the other.
  //
  // ── Option 1: No Branch Protection ────────────────────
  // Renovate merges PRs directly via API without waiting for CI.
  // Simple setup, no GitHub Branch Protection rules required.
  //
  // ── Option 2: With Branch Protection ────
  // GitHub native auto-merge: waits for required status checks.
  // Requires: Settings → Branches → Branch protection rules →
  //   "Require status checks to pass before merging"
  // ================================================================

  // ── Option 1: No Branch Protection ──────────────────────────────
  "platformAutomerge": false,   // Renovate merges via API, not GitHub native
  "ignoreTests": true,          // Don't wait for CI before merging

  // ── Option 2: With Branch Protection ────────────────────────────
  // "platformAutomerge": true, // Use GitHub native auto-merge
  // "ignoreTests": false,      // Wait for required CI checks (default)
  // "prCreation": "not-pending", // Create PR only when checks finish
  // "internalChecksAsSuccess": true, // Count renovate/stability-days as passing check

  // ── Common settings (apply to both options) ──────────────────────
  "automergeStrategy": "squash", // Squash commits on merge (clean history)

  // ================================================================
  // 📦 DEPENDENCY UPDATE RULES
  // ================================================================
  // Fine-grained policies per dependency type, ecosystem, or version bump
  //
  // Rule matching is based on:
  // - matchManagers: which package manager (gradle, npm, pip, etc.)
  // - matchUpdateTypes: version bump type (major, minor, patch)
  // - matchPackageNames: specific package names
  // - matchPackagePatterns: regex pattern for package names
  // - matchDepTypes: dependency type (dependencies, devDependencies, etc.)
  //
  // Rules are evaluated top-to-bottom; later rules override earlier ones
  // ================================================================

  "packageRules": [

    // ================================================================
    // 🔄 UPDATE CHANNELS (Patch/Minor/Major)
    // ================================================================
    // Define auto-merge behavior per semantic version bump type
    // ================================================================

    {
      "description": "🟢 Patch updates: auto-merge (bug fixes, backwards-compatible)",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      // Examples: 1.2.3 → 1.2.4, 2.0.0 → 2.0.1
      // Should be safe to auto-merge (except for known buggy releases)
    },

    {
      "description": "🟡 Minor updates: auto-merge (new features, backwards-compatible)",
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      // Examples: 1.2.0 → 1.3.0, 2.0.0 → 2.1.0
      // Usually safe if project follows semantic versioning
    },

    {
      "description": "🔴 Major updates: manual review (breaking changes expected)",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      // Examples: 1.0.0 → 2.0.0, 2.5.3 → 3.0.0
      // Requires manual review: API changes, deprecations, migrations
    },

    {
      "description": "🔁 GitHub Actions: grouped auto-merge (including majors)",
      "matchManagers": ["github-actions"],
      // Allow automerge for patch, minor *and* major updates of GitHub Actions:
      "automerge": true,
      // Group all GitHub Actions updates into a single PR (less noise):
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      // Do not split the group by major/minor/patch:
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },

    // ================================================================
    // 📦 DEV / TEST DEPENDENCIES GROUPING
    // ================================================================
    // Group all development/test dependencies into a single PR to
    // reduce noise. This is generic and can be adapted per ecosystem.
    //
    // Notes:
    // - matchDepTypes values are manager-specific.
    // - For npm:        devDependencies, optionalDependencies (etc.)
    // - For Composer:   require-dev
    // - For Gradle:     configuration names (testImplementation, etc.)
    // - For Maven:      test, provided (depending on setup)
    //
    // Adjust the list below to match your actual stack.
    // ================================================================
    {
      "description": "📦 Group all dev/test dependencies into a single PR",
      "matchDepTypes": [
        // Node.js / npm / yarn
        "devDependencies",
        "optionalDependencies",

        // PHP / Composer
        "require-dev",

        // Generic "test" buckets
        "test",
        "testDependencies",

        // Gradle configurations used for tests/dev
        "testCompileOnly",
        "testImplementation",
        "testRuntimeOnly",
        "testAnnotationProcessor"
      ],
      "groupName": "Dev / Test dependencies",
      "groupSlug": "dev-test-deps",
      // Do NOT split by major/minor/patch inside this group:
      "separateMajorMinor": false,
      "separateMinorPatch": false
    },

    // ================================================================
    // 💬 COMMIT MESSAGE FORMATTING
    // ================================================================
    // Customize commit messages per package manager
    //
    // Default format (with semanticCommits: enabled):
    //   "chore(deps): update dependency foo to v2.0.0"
    //
    // Custom format (with semanticCommits: disabled):
    //   "[Manager] Update dependency foo to v2.0.0"
    //
    // 📝 Adapt these rules for your package managers:
    //    - Gradle → [Gradle]
    //    - npm → [npm]
    //    - Composer → [Composer]
    //    - pip → [Python]
    // ================================================================

    {
      "description": "💬 GitHub Actions: custom commit message prefix",
      "matchManagers": ["github-actions"],
      "commitMessagePrefix": "[GitHub Actions] ",
      "semanticCommits": "disabled",
      // Example: "[GitHub Actions] Update actions/checkout action to v4.2.0"
    },

    // ================================================================
    // 🎯 PROJECT-SPECIFIC RULES
    // ================================================================
    // Custom policies for specific dependencies in this project
    //
    // 📝 These are project-specific examples. Customize or remove for your project:
    //    - Ignore unstable/breaking dependencies
    //    - Pin specific versions
    //    - Group related updates
    // ================================================================

    {
      "description": "🛠️ Temporarily skip umbrelladocs/action-linkspector v1.5.5 (broken release)",
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "umbrelladocs/action-linkspector"
      ],
      "allowedVersions": "!/^v?1\\.5\\.5$/"
    },
  ],

  // ================================================================
  // 🔐 VULNERABILITY ALERTS
  // ================================================================
  // Dedicated PRs for security fixes.
  // Renovate reads GitHub vulnerability alerts and raises dedicated
  // security-fix PRs.
  //
  // Behavior:
  //   • Ignore the global "schedule" and PR rate limits: created as
  //     soon as Renovate runs and sees an alert.
  //   • Because Renovate is expected to run daily, security PRs can
  //     appear on any day, even if regular updates are restricted to
  //     specific days by "schedule".
  //   • With automerge: true + ignoreTests: true they are merged
  //     immediately once created.
  //
  // Sources:
  //   • GitHub Security Advisories / Dependabot alerts
  //   • Optionally OSV, etc. (see osvVulnerabilityAlerts)
  // ================================================================
  "vulnerabilityAlerts": {
    "enabled": true,              // Enable security vulnerability detection
    "automerge": true,            // Auto-merge security fix PRs as soon as they appear
    "labels": ["security", "priority-high"]
  }
}